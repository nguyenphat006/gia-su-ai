msgid "Câu trắc nghiệm phải có đúng 4 phương án."
msgstr "A multiple-choice question must have exactly 4 options."

msgid "Các phương án không được trống hoặc trùng nhau."
msgstr "Options must not be empty or duplicated."

msgid "Đáp án đúng phải là một trong 4 phương án."
msgstr "The correct answer must be one of the 4 options."

msgid "Mỗi thẻ phải có đủ mặt trước và mặt sau."
msgstr "Each card must have both a front and a back."

msgid "Id nút '%(id)s' bị trùng."
