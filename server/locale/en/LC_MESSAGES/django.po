msgid "Nút '%(label)s' trỏ tới nút cha không tồn tại."
msgstr "Node '%(label)s' points to a parent that does not exist."

msgid "Sơ đồ có vòng lặp tại nút '%(label)s'."
msgstr "The mind map has a cycle at node '%(label)s'."

