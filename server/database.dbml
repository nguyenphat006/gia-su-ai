// ==============================================================================
// GIA SƯ AI KHTN - NỀN TẢNG HỌC KHOA HỌC TỰ NHIÊN THCS VỚI TRỢ LÝ AI
// ==============================================================================
// Quy chuẩn đặt tên (Naming Conventions):
// - Tên Bảng: PascalCase (Số nhiều)
// - Tên Cột: PascalCase
// - Khóa chính (PK): Id (int auto-increment; bảng nhật ký dùng bigint)
// - Khóa ngoại (FK): <TargetEntitySingular>Id
// - Chuẩn Audit Fields: Description, IsActive, CreatedById, UpdatedById, CreatedAt, UpdatedAt, DeletedAt
// - Bảng nhật ký ghi một lần (ChatMessages, XpLogs, LearningEvents, ArenaParticipants, UserChallenges, UserStats)
//   chỉ có CreatedAt/UpdatedAt — không xóa mềm, không theo dõi pghistory
// ==============================================================================


// ==============================================================================
// MODULE 0: HỆ THỐNG & PHÂN QUYỀN NGƯỜI DÙNG (SYSTEM & RBAC)
// ==============================================================================

// 0.1 Tài khoản Đăng nhập Hệ thống (Users)
Table Users {
  Id int [primary key, increment]
  Username varchar(100) [not null, unique, note: 'Tên đăng nhập hệ thống']
  PasswordHash varchar(255) [not null, note: 'Mật khẩu băm PBKDF2; tài khoản chuyển từ bản cũ giữ dạng scrypt và tự nâng cấp khi đăng nhập']
  Email varchar(255) [not null, default: '', note: 'Email tài khoản — học sinh có thể để trống; nếu có thì duy nhất trong các tài khoản chưa xóa']
  FullName varchar(255) [not null, note: 'Họ và tên hiển thị của người dùng']
  PhoneNumber varchar(30) [null, note: 'Số điện thoại liên hệ / 2FA']
  Avatar varchar(500) [null, note: 'Đường dẫn ảnh đại diện']
  IsSuperuser boolean [default: false, note: 'Quyền quản trị tối cao hệ thống']
  LastLoginAt timestamp [null, note: 'Thời điểm đăng nhập gần nhất']
  MustChangePassword boolean [default: false, note: 'Bắt đổi mật khẩu ở lần đăng nhập tới (tài khoản mới tạo / import / reset)']
  
  // Standard Audit Fields
  Description text [null, note: 'Ghi chú tài khoản']
  IsActive boolean [default: true, note: 'Trạng thái hoạt động: True = Hoạt động, False = Khóa/Ngưng']
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete cho user: null là đang dùng, có ngày giờ là đã xóa mềm']
}

// 0.2 Danh mục Vai trò / Chức danh (Roles)
Table Roles {
  Id int [primary key, increment]
  RoleCode varchar(50) [not null, unique, note: 'Mã vai trò: ADMIN, TEACHER, STUDENT']
  RoleName varchar(255) [not null, note: 'Tên hiển thị: Quản trị viên, Giáo viên, Học sinh']
  
  // Standard Audit Fields
  Description text [null, note: 'Mô tả quyền hạn và trách nhiệm của vai trò']
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']
}

// 0.3 Danh mục Quyền hạn chi tiết (Permissions)
Table Permissions {
  Id int [primary key, increment]
  PermissionCode varchar(100) [not null, unique, note: 'Mã quyền: BOM_CREATE, BOM_APPROVE, FINISH_APPROVE, WO_RELEASE, MATERIAL_EXPORT, VIEW_COST_PRICE']
  PermissionName varchar(255) [not null, note: 'Tên quyền: Tạo cây BOM, Phê duyệt BOM, Duyệt công thức sơn, Lập lệnh SX, Cấp phát xuất kho, Xem giá vốn...']
  Module varchar(50) [not null, note: 'Thuộc phân hệ: SYSTEM, PRODUCT, BOM, FINISH, PLANNING, INVENTORY']
  
  Description text [null, note: 'Mô tả chi tiết tác vụ của quyền']
  CreatedAt timestamp [default: `now()`]
}

// 0.4 Bảng trung gian gán Vai trò cho Người dùng (UserRoles: N-N)
Table UserRoles {
  UserId int [not null, ref: > Users.Id, note: 'Người dùng nào']
  RoleId int [not null, ref: > Roles.Id, note: 'Được gán vai trò nào']
  
  CreatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]

  indexes {
    (UserId, RoleId) [pk, note: 'Khóa chính kết hợp chống gán trùng vai trò']
  }
}

// 0.5 Bảng trung gian gán Quyền cho Vai trò (RolePermissions: N-N)
Table RolePermissions {
  RoleId int [not null, ref: > Roles.Id, note: 'Vai trò nào']
  PermissionId int [not null, ref: > Permissions.Id, note: 'Có quyền hạn gì']
  
  CreatedAt timestamp [default: `now()`]

  indexes {
    (RoleId, PermissionId) [pk, note: 'Khóa chính kết hợp chống gán trùng quyền']
  }
}

// 0.6 Danh mục Phân hệ & Cấu hình Điều hướng (ModuleRegistries)
Table ModuleRegistries {
  Id int [primary key, increment]
  ModuleCode varchar(50) [not null, unique, note: 'Mã phân hệ: USER, SYSTEM, PRODUCT, BOM, FINISH, PLANNING, MANUFACTURING, INVENTORY, FINANCE']
  ModuleName varchar(255) [not null, note: 'Tên hiển thị tiếng Việt (ngôn ngữ mặc định): Quản lý Người dùng, Cây định mức BOM...']
  ModuleNameEn varchar(255) [null, note: 'Tên hiển thị tiếng Anh; trống -> dùng ModuleName']
  Icon varchar(100) [null, note: 'Khóa icon trong client/src/constants/iconMap.tsx (lucide): UserOutlined, AppstoreOutlined...']
  RoutePath varchar(255) [null, note: 'Đường dẫn URL trên Frontend: /users, /products (null nếu là group header hoặc không có trang)']
  ParentCode varchar(50) [null, note: 'Mã phân hệ cha (null nếu là top-level menu)']
  SortOrder int [default: 0, note: 'Thứ tự hiển thị trên Sidebar menu']
  IsNavigation boolean [default: true, note: 'True = hiển thị trên Sidebar, False = ẩn khỏi menu (nhưng vẫn có quyền)']
  IsActive boolean [default: true, note: 'Trạng thái kích hoạt phân hệ']
  
  // Standard Audit Fields
  Description text [null, note: 'Mô tả phạm vi phân hệ (tiếng Việt)']
  DescriptionEn text [null, note: 'Mô tả tiếng Anh; trống -> dùng Description']
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
}

// 0.7 Nhật ký thao tác & Lịch sử thay đổi mô hình (AuditEvents - django-pghistory)
Table AuditEvents {
  Id bigint [primary key, increment]
  PghSlug varchar(64) [not null, unique, note: 'Khóa slug duy nhất của sự kiện']
  PghModel varchar(100) [not null, note: 'Tên model bảng lịch sử: e.g. authentication.UserEvent']
  PghLabel varchar(50) [not null, note: 'Loại sự kiện: snapshot, insert, update, delete']
  PghObjModel varchar(100) [not null, note: 'Tên model gốc bị tác động: e.g. authentication.CustomUser']
  PghObjId int [not null, note: 'Khóa chính của bản ghi bị tác động']
  PghData jsonb [not null, note: 'Dữ liệu toàn bộ bản ghi tại thời điểm ghi vết']
  PghDiff jsonb [null, note: 'Sai khác so với bản ghi trước (trường thay đổi: giá trị cũ -> mới)']
  PghContext jsonb [null, note: 'Ngữ cảnh HTTP: User ID, URL request, IP, Request ID']
  PghCreatedAt timestamp [default: `now()`, note: 'Thời điểm trigger PostgreSQL ghi vết']

  indexes {
    (PghObjModel, PghObjId) [note: 'Tìm kiếm lịch sử theo đối tượng']
    PghCreatedAt [note: 'Sắp xếp theo thời gian sự kiện']
  }
}

// 0.8 Quản lý Tệp Đính Kèm Đa Hình (Attachments - Polymorphic File Storage)
Table Attachments {
  Id int [primary key, increment]
  EntityType varchar(50) [not null, note: 'Tên loại thực thể: USER, PRODUCT_BASE, PRODUCT_VARIANT, MATERIAL, FINISH, WORK_ORDER...']
  EntityId int [not null, note: 'Khóa chính Id của thực thể được đính kèm tệp']
  
  FileName varchar(255) [not null, note: 'Tên gốc của tệp khi tải lên']
  FileUrl varchar(500) [not null, note: 'Đường dẫn tệp lưu trữ trong hệ thống / storage']
  FileSize bigint [not null, default: 0, note: 'Dung lượng tệp tính theo bytes']
  MimeType varchar(100) [null, note: 'Định dạng MIME (image/png, application/pdf, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet...)']
  FileCategory varchar(50) [default: 'DOCUMENT', note: 'Phân loại tệp: IMAGE, CAD_DRAWING, SPEC_SHEET, CONTRACT, DOCUMENT, OTHER']
  
  // Standard Audit Fields
  Description text [null, note: 'Ghi chú / Diễn giải tệp']
  IsActive boolean [default: true]
  CreatedById int [ref: > Users.Id]
  UpdatedById int [ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (EntityType, EntityId) [note: 'Index tối ưu truy vấn danh sách tệp của một thực thể cụ thể']
  }
}

// 0.9 Quản lý Tiến trình Xuất / Nhập Dữ liệu Tác vụ Ngầm (DataTransferJobs - Celery Async Tasks)
Table DataTransferJobs {
  Id bigint [primary key, increment]
  JobType varchar(30) [not null, note: 'EXPORT_EXCEL, EXPORT_CSV, IMPORT_EXCEL']
  EntityType varchar(50) [not null, note: 'Tên loại thực thể: USER, PRODUCT_BASE, MATERIAL, CUSTOMER...']
  Status varchar(20) [not null, default: 'PENDING', note: 'Trạng thái: PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED']
  Progress int [default: 0, note: 'Tiến độ hoàn thành từ 0 đến 100%']
  TotalRows int [default: 0, note: 'Tổng số dòng cần xử lý']
  ProcessedRows int [default: 0, note: 'Số dòng đã xử lý xong']
  
  FileUrl varchar(500) [null, note: 'Đường dẫn tải file kết quả sau khi render xong']
  ErrorFileUrl varchar(500) [null, note: 'Đường dẫn file tổng hợp các dòng lỗi nếu import thất bại']
  ErrorMessage text [null, note: 'Chi tiết lỗi nếu tác vụ thất bại']
  QueryParams jsonb [null, note: 'Lưu các tham số bộ lọc, tìm kiếm, cột đã chọn để tái hiện']
  
  StartedAt timestamp [null, note: 'Thời điểm worker bắt đầu thực thi']
  CompletedAt timestamp [null, note: 'Thời điểm hoàn tất tác vụ']

  // Standard Audit Fields
  Description text [null, note: 'Ghi chú / Mô tả tác vụ']
  IsActive boolean [default: true]
  CreatedById int [ref: > Users.Id]
  UpdatedById int [ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (CreatedById, Status) [note: 'Tìm nhanh danh sách tác vụ của người dùng']
    CreatedAt [note: 'Sắp xếp theo thời gian tạo']
  }
}

// 0.10 Thông báo trong ứng dụng (chuông trên topbar)
Table Notifications {
  Id bigint [primary key, increment]
  RecipientId int [not null, ref: > Users.Id, note: 'Người nhận']
  Level varchar(20) [not null, default: 'INFO', note: 'INFO, SUCCESS, WARNING, ERROR']
  Title varchar(255) [not null]
  Message text [null]
  Link varchar(500) [null, note: 'Đường dẫn frontend khi bấm vào (vd. /users/5) hoặc link tải file']
  SourceType varchar(50) [null, note: 'Nguồn phát sinh: DATA_TRANSFER_JOB, USER...']
  SourceId bigint [null]
  ReadAt timestamp [null, note: 'NULL = chưa đọc']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [ref: > Users.Id]
  UpdatedById int [ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (RecipientId, ReadAt) [note: 'Đếm / lọc chưa đọc của người dùng']
    CreatedAt
  }
}

// 0.11 Cấu hình hệ thống (1 dòng duy nhất)
Table SystemSettings {
  Id int [primary key, increment]
  AppName varchar(100) [not null, note: 'Tên ứng dụng: sidebar, trang đăng nhập, tiêu đề tab']
  AppBadge varchar(30) [null, note: 'Nhãn phụ cạnh tên (vd. MES 2.0)']
  Tagline varchar(150) [null]
  CompanyName varchar(255) [null, note: 'Tên đơn vị sở hữu, hiện ở footer']
  LogoUrl varchar(500) [null, note: 'Logo tải lên; NULL = dùng logo mặc định']
  Timezone varchar(50) [not null, default: 'Asia/Ho_Chi_Minh']
  DateFormat varchar(20) [not null, default: 'DD/MM/YYYY']
  NumberFormat varchar(10) [not null, default: 'INTL', note: 'INTL = 1,250.50; VN = 1.250,50 (mặc định cho user chưa tự chọn)']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [ref: > Users.Id]
  UpdatedById int [ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']
}


// ==============================================================================
// MODULE 1: HỌC VỤ (ACADEMICS) — app `academics`
// ==============================================================================

// 1.1 Lớp học
Table Classes {
  Id int [primary key, increment]
  Code varchar(50) [not null, unique, note: 'Mã lớp: 6A1-2026']
  Name varchar(100) [not null, note: 'Tên lớp: 6A1']
  Grade smallint [not null, note: 'Khối lớp: 6, 7, 8, 9']
  AcademicYear varchar(20) [not null, note: 'Năm học: 2026-2027']
  HomeroomTeacherId int [null, ref: > Users.Id, note: 'Giáo viên chủ nhiệm']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (Name, AcademicYear) [unique, note: 'Một năm học không trùng tên lớp']
    Grade
  }
}

// 1.2 Hồ sơ học sinh (1-1 với Users có vai trò STUDENT)
Table StudentProfiles {
  Id int [primary key, increment]
  UserId int [not null, unique, ref: - Users.Id]
  StudentCode varchar(30) [not null, unique, note: 'Mã học sinh, dùng được để đăng nhập']
  Grade smallint [not null, note: 'Khối lớp hiện tại: 6-9']
  ClassId int [null, ref: > Classes.Id, note: 'Lớp đang học']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    ClassId
    Grade
  }
}

// 1.3 Hồ sơ giáo viên (1-1 với Users có vai trò TEACHER)
Table TeacherProfiles {
  Id int [primary key, increment]
  UserId int [not null, unique, ref: - Users.Id]
  EmployeeCode varchar(30) [null, unique, note: 'Mã giáo viên']
  Subject varchar(100) [null, note: 'Bộ môn: Vật lý, Hóa học, Sinh học, KHTN']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']
}

// ==============================================================================
// MODULE 2: CẤU HÌNH AI (AI SETTINGS) — app `ai_settings`
// ==============================================================================

// 2.1 Tham số AI dạng khóa / giá trị (prompt gia sư, guard, model, nhiệt độ...)
Table AiSettings {
  Id int [primary key, increment]
  Key varchar(100) [not null, unique, note: 'AI_SYSTEM_PROMPT, AI_MODEL, AI_TEMPERATURE, AI_GUARD_ENABLED, AI_GUARD_PROMPT, AI_GUARD_MODEL, AI_GUARD_XP_PENALTY_BASE, AI_GUARD_BLOCK_MESSAGE, AI_MAX_HISTORY_MESSAGES, AI_EMBEDDING_MODEL, RAG_TOP_K']
  Label varchar(255) [not null, note: 'Tên hiển thị trên màn cấu hình']
  Value text [not null]
  ValueType varchar(20) [not null, default: 'TEXT', note: 'TEXT, PROMPT, NUMBER, BOOLEAN — quyết định ô nhập và kiểm tra hợp lệ']

  // Standard Audit Fields
  Description text [null, note: 'Giải thích tác dụng, placeholder hỗ trợ ({context}, {message})']
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']
}

// ==============================================================================
// MODULE 3: NGÂN HÀNG TRI THỨC RAG (KNOWLEDGE) — app `knowledge`
// ==============================================================================

// 3.1 Tài liệu gốc giáo viên tải lên (PDF / DOCX / TXT). Tệp lưu ở Attachments (EntityType = SOURCE_DOCUMENT)
Table SourceDocuments {
  Id int [primary key, increment]
  Title varchar(255) [not null, note: 'Tên tài liệu (mặc định = tên tệp)']
  Grade smallint [null, note: 'Khối áp dụng; NULL = dùng chung mọi khối']
  Topic varchar(255) [null, note: 'Chủ đề / bài học']
  Status varchar(20) [not null, default: 'PROCESSING', note: 'PROCESSING, COMPLETED, FAILED']
  TotalChunks int [default: 0]
  ProcessedChunks int [default: 0]
  RawText text [null, note: 'Văn bản trích xuất toàn bộ']
  GenerateQuestions boolean [default: true, note: 'Có sinh câu hỏi từ tài liệu không']
  ErrorMessage text [null, note: 'Lý do khi FAILED']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']
}

// 3.2 Đoạn tri thức dùng cho RAG (cắt từ tài liệu hoặc giáo viên nhập tay)
Table KnowledgeChunks {
  Id int [primary key, increment]
  SourceDocumentId int [null, ref: > SourceDocuments.Id, note: 'NULL = nhập tay']
  ChunkIndex int [null, note: 'Thứ tự đoạn trong tài liệu']
  Title varchar(255) [not null]
  Content text [not null]
  Grade smallint [null, note: 'NULL = dùng chung mọi khối']
  Topic varchar(255) [null]
  Embedding vector(768) [null, note: 'pgvector — Gemini embedding (output_dimensionality=768); NULL = chưa nhúng']
  EmbeddedAt timestamp [null]

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    SourceDocumentId
    Grade
    Embedding [type: hnsw, note: 'vector_cosine_ops']
  }
}

// ==============================================================================
// MODULE 4: ÔN TẬP (REVISION) — app `revision`
// ==============================================================================

// 4.1 Ngân hàng câu hỏi
Table Questions {
  Id int [primary key, increment]
  Grade smallint [null]
  ClassId int [null, ref: > Classes.Id, note: 'Chỉ dành cho 1 lớp; NULL = cả khối']
  Topic varchar(255) [not null]
  QuestionType varchar(20) [not null, default: 'MULTIPLE_CHOICE', note: 'MULTIPLE_CHOICE, ESSAY']
  Difficulty varchar(20) [not null, default: 'NHAN_BIET', note: 'NHAN_BIET, THONG_HIEU, VAN_DUNG']
  Content text [not null, note: 'Nội dung câu hỏi (markdown + LaTeX)']
  Options jsonb [null, note: 'Mảng 4 phương án (chuỗi) — chỉ trắc nghiệm']
  CorrectAnswer text [not null, note: 'Trắc nghiệm: nguyên văn phương án đúng; tự luận: đáp án mẫu']
  Explanation text [null]
  Hint text [null, note: 'Gợi ý khi trả lời sai lần đầu (đấu trường)']
  Status varchar(20) [not null, default: 'APPROVED', note: 'PENDING, APPROVED, REJECTED']
  Origin varchar(20) [not null, default: 'MANUAL', note: 'MANUAL, AI, DOCUMENT']
  SourceDocumentId int [null, ref: > SourceDocuments.Id]

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (Grade, Topic)
    (Status, IsActive)
  }
}

// 4.2 Bộ flashcard
Table FlashcardDecks {
  Id int [primary key, increment]
  Grade smallint [null]
  ClassId int [null, ref: > Classes.Id]
  Topic varchar(255) [not null]
  Title varchar(255) [not null]
  Cards jsonb [not null, note: 'Mảng {front, back}']
  Origin varchar(20) [not null, default: 'MANUAL', note: 'MANUAL, AI']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (Grade, Topic)
  }
}

// 4.3 Sơ đồ tư duy
Table Mindmaps {
  Id int [primary key, increment]
  Grade smallint [null]
  ClassId int [null, ref: > Classes.Id]
  Topic varchar(255) [not null]
  Title varchar(255) [not null]
  Nodes jsonb [not null, note: 'Mảng {id, label, parentId} — parentId NULL là gốc']
  Origin varchar(20) [not null, default: 'MANUAL', note: 'MANUAL, AI']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (Grade, Topic)
  }
}

// 4.4 Lượt làm bài ôn tập của học sinh
Table QuizAttempts {
  Id int [primary key, increment]
  UserId int [not null, ref: > Users.Id]
  QuizType varchar(20) [not null, default: 'CHINH_PHUC', note: 'CHINH_PHUC, FLASHCARD_QUIZ']
  Grade smallint [null]
  Topic varchar(255) [null]
  TotalQuestions int [not null]
  CorrectCount int [not null]
  XpEarned int [default: 0]
  Answers jsonb [null, note: 'Chi tiết từng câu: {questionId, answer, isCorrect}']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (UserId, CreatedAt)
  }
}

// ==============================================================================
// MODULE 5: GIA SƯ AI (TUTOR CHAT) — app `tutor`
// ==============================================================================

// 5.1 Phiên trò chuyện
Table ChatSessions {
  Id int [primary key, increment]
  UserId int [not null, ref: > Users.Id]
  Title varchar(255) [not null]
  LastMessageAt timestamp [null]

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete — học sinh xóa phiên']

  indexes {
    (UserId, LastMessageAt)
  }
}

// 5.2 Tin nhắn (bảng nhật ký, ghi một lần — không dùng khối audit đầy đủ). Ảnh đính kèm: Attachments (EntityType = CHAT_MESSAGE)
Table ChatMessages {
  Id bigint [primary key, increment]
  SessionId int [not null, ref: > ChatSessions.Id]
  Role varchar(10) [not null, note: 'USER, MODEL, SYSTEM']
  Content text [not null]
  IsBlocked boolean [default: false, note: 'Bị bộ lọc nội dung chặn']
  BlockReason varchar(500) [null]
  ContextChunkIds jsonb [null, note: 'Id các KnowledgeChunks đã dùng làm ngữ cảnh RAG']
  CreatedAt timestamp [default: `now()`]

  indexes {
    (SessionId, CreatedAt)
  }
}

// ==============================================================================
// MODULE 6: ĐẤU TRƯỜNG (ARENA) — app `arena`, realtime qua Django Channels
// ==============================================================================

// 6.1 Trận đấu
Table ArenaMatches {
  Id int [primary key, increment]
  Mode varchar(10) [not null, note: 'PVP, AI']
  Grade smallint [null]
  Topic varchar(255) [not null]
  QuestionType varchar(20) [not null, default: 'MULTIPLE_CHOICE']
  Questions jsonb [not null, note: 'Ảnh chụp đề tại thời điểm thi đấu (kèm đáp án — không trả cho client trước khi trả lời)']
  Status varchar(20) [not null, default: 'IN_PROGRESS', note: 'IN_PROGRESS, FINISHED, ABANDONED']
  StartedAt timestamp [not null, default: `now()`]
  EndedAt timestamp [null]
  AiAnalysis jsonb [null, note: 'Nhận xét AI sau trận: {score, analysis, advice} theo từng người chơi']

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']

  indexes {
    (Mode, CreatedAt)
  }
}

// 6.2 Người chơi trong trận (2 dòng / trận; đối thủ AI có UserId NULL)
Table ArenaParticipants {
  Id int [primary key, increment]
  MatchId int [not null, ref: > ArenaMatches.Id]
  UserId int [null, ref: > Users.Id, note: 'NULL = đối thủ AI']
  Score int [default: 0]
  CorrectCount int [default: 0]
  IsWinner boolean [default: false]
  XpEarned int [default: 0]
  Answers jsonb [null, note: 'Mảng {questionIndex, answer, isCorrect, timeLeft, points}']
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp

  indexes {
    (MatchId, UserId) [unique]
    (UserId, CreatedAt)
  }
}

// ==============================================================================
// MODULE 7: THÀNH TÍCH (GAMIFICATION) — app `gamification`
// ==============================================================================

// 7.1 Thống kê tích lũy của học sinh
Table UserStats {
  Id int [primary key, increment]
  UserId int [not null, unique, ref: - Users.Id]
  TotalXp int [default: 0, note: 'Không bao giờ âm']
  WeeklyXp int [default: 0, note: 'Reset 00:00 thứ Hai (Celery beat)']
  Points int [default: 0]
  CurrentStreak int [default: 0]
  LongestStreak int [default: 0]
  LastStudyDate date [null, note: 'Ngày học gần nhất theo giờ Việt Nam']
  UpdatedAt timestamp
}

// 7.2 Sổ cái XP (bảng nhật ký, ghi một lần)
Table XpLogs {
  Id bigint [primary key, increment]
  UserId int [not null, ref: > Users.Id]
  Amount int [not null, note: 'Âm = trừ điểm']
  Action varchar(30) [not null, note: 'CHAT_AI, COMPLETE_QUIZ, ARENA, DAILY_LOGIN, ADMIN_BONUS, QUEST_COMPLETED, GUARD_PENALTY']
  SourceType varchar(30) [null, note: 'CHAT_MESSAGE, QUIZ_ATTEMPT, ARENA_MATCH, USER_CHALLENGE']
  SourceId bigint [null]
  CreatedAt timestamp [default: `now()`]

  indexes {
    (UserId, CreatedAt)
    (Action, CreatedAt)
  }
}

// 7.3 Danh mục thử thách
Table Challenges {
  Id int [primary key, increment]
  Code varchar(50) [not null, unique, note: 'S_GIA_CAU_HOI, CHIEN_BINH_TRI_TUE, CHIEN_BINH_DA_TAI']
  Name varchar(255) [not null]
  TriggerAction varchar(30) [not null, note: 'Hành động tăng tiến độ: CHAT_AI, COMPLETE_QUIZ, FLASHCARD_QUIZ, ARENA']
  Goal int [not null, default: 1]
  Period varchar(10) [not null, default: 'DAILY', note: 'DAILY, WEEKLY, ONCE']
  XpReward int [default: 0]
  PointsReward int [default: 0]

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']
}

// 7.4 Tiến độ thử thách theo kỳ (kỳ mới = dòng mới, không cần job reset)
Table UserChallenges {
  Id int [primary key, increment]
  UserId int [not null, ref: > Users.Id]
  ChallengeId int [not null, ref: > Challenges.Id]
  PeriodKey varchar(20) [not null, note: 'DAILY: 2026-10-17, WEEKLY: 2026-W42, ONCE: ONCE']
  Progress int [default: 0]
  CompletedAt timestamp [null]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp

  indexes {
    (UserId, ChallengeId, PeriodKey) [unique]
  }
}

// 7.5 Bậc danh hiệu theo XP (thay bảng viết cứng ở 3 nơi trong bản cũ)
Table LevelTiers {
  Id int [primary key, increment]
  Title varchar(100) [not null, note: 'NHÀ KHOA HỌC NHÍ, SỨ GIẢ CHÂN LÝ...']
  MinXp int [not null, unique]
  SortOrder int [default: 0]

  // Standard Audit Fields
  Description text [null]
  IsActive boolean [default: true]
  CreatedById int [null, ref: > Users.Id]
  UpdatedById int [null, ref: > Users.Id]
  CreatedAt timestamp [default: `now()`]
  UpdatedAt timestamp
  DeletedAt timestamp [null, note: 'Soft delete']
}

// ==============================================================================
// MODULE 8: PHÂN TÍCH HỌC TẬP (ANALYTICS) — app `analytics`
// ==============================================================================

// 8.1 Sự kiện học tập (bảng nhật ký, ghi một lần) — nguồn cho heatmap và thống kê từng học sinh
Table LearningEvents {
  Id bigint [primary key, increment]
  UserId int [not null, ref: > Users.Id]
  EventType varchar(30) [not null, note: 'LOGIN, CHAT, QUIZ, FLASHCARD_VIEW, MINDMAP_VIEW, ARENA']
  SourceType varchar(30) [null]
  SourceId bigint [null]
  Metadata jsonb [null, note: 'Thông tin phụ: topic, grade...']
  OccurredAt timestamp [not null, default: `now()`]

  indexes {
    (UserId, OccurredAt)
    (EventType, OccurredAt)
  }
}
